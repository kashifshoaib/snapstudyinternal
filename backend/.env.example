# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key

# Bedrock Configuration
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20240620-v1:0
BEDROCK_REGION=us-east-1

# Bedrock Agents Configuration (Optional - for AgentCore)
LEARNING_AGENT_ID=
ADAPTIVE_AGENT_ID=
BEDROCK_AGENT_ALIAS_ID=TSTALIASID

# Knowledge Base Configuration (Optional)
KNOWLEDGE_BASE_ID=
OPENSEARCH_ENDPOINT=

# Bedrock Guardrails Configuration (Optional)
BEDROCK_GUARDRAIL_ID=
BEDROCK_GUARDRAIL_VERSION=DRAFT

# DynamoDB Table Names
USERS_TABLE=SnapStudy-Users
LESSONS_TABLE=SnapStudy-Lessons
MICRO_LESSONS_TABLE=SnapStudy-MicroLessons
QUIZZES_TABLE=SnapStudy-Quizzes
USER_ENGAGEMENT_TABLE=SnapStudy-UserEngagement
CHAT_HISTORY_TABLE=SnapStudy-ChatHistory
AUDIO_LESSONS_TABLE=SnapStudy-AudioLessons
VIDEO_LESSONS_TABLE=SnapStudy-VideoLessons

# S3 Configuration
CONTENT_BUCKET=snapstudy-content
S3_BUCKET_NAME=snapstudy-content
AUDIO_CONTENT_BUCKET=snapstudy-audio-content

# Cognito Configuration
USER_POOL_ID=
USER_POOL_CLIENT_ID=

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Environment
ENVIRONMENT=development

# API Configuration
API_VERSION=1.0.0

# Rate Limiting Configuration
BEDROCK_MAX_RPM=80
BEDROCK_BURST_CAPACITY=10
BEDROCK_AGENT_MAX_RPM=40
BEDROCK_MODEL_MAX_RPM=60
MAX_CONCURRENT_REQUESTS=2
REQUEST_PROCESSING_DELAY=0.8
