# AWS Configuration
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012

# AWS Credentials (fallback if not in environment variables)
# Uncomment and fill in if not using environment variables or AWS CLI
# AWS_ACCESS_KEY_ID=your_access_key_here
# AWS_SECRET_ACCESS_KEY=your_secret_key_here
# AWS_SESSION_TOKEN=your_session_token_here (if using temporary credentials)

# Environment
ENVIRONMENT=dev

# Domain Configuration (optional)
DOMAIN_NAME=snapstudy.example.com
CERTIFICATE_ARN=arn:aws:acm:us-east-1:123456789012:certificate/12345678-1234-1234-1234-123456789012

# Bedrock Configuration
BEDROCK_REGION=us-east-1
CLAUDE_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0

# Frontend Configuration
FRONTEND_URL=http://localhost:3000

# Alert Email (for production deployments)
ALERT_EMAIL=admin@example.com